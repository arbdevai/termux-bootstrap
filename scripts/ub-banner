    printf '│  ub stop     matikan Ubuntu + 9router   │\n'
    printf '│  ub reset    bersihkan + masuk ulang    │\n'
    printf '│  ub scan     deep scan proses yatim     │\n'
    printf '│  ub help     bantuan                    │\n'
    printf '\033[1;34m'
    printf '└─────────────────────────────────────────┘\n'
    printf '\033[0m'
